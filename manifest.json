{
  "manifest_version": 3,
  "name": "AI Post Composer (MVP)",
  "version": "0.1.0",
  "description": "Fast post composer with templates and tone presets for LinkedIn/Twitter. Generate, edit, and copy posts quickly.",
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Post Composer"
  },
  "permissions": [
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js"
  }
}
